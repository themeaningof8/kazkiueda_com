---
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import PortfolioLayout from '../../../layouts/PortfolioLayout.astro';
import CaseStudyDetailToc from '../../../components/portfolio/CaseStudyDetailToc.astro';
import CaseStudyDetailRelated from '../../../components/portfolio/CaseStudyDetailRelated.astro';
import CaseStudyDetailTocScrollSpy from '../../../components/portfolio/CaseStudyDetailTocScrollSpy.astro';
import type { CaseStudyDetailHeaderProps } from '../../../components/portfolio/portfolio-types';
import { tocFromMarkdownHeadings } from '../../../lib/case-study-toc';

export const prerender = true;

export const getStaticPaths = (async () => {
  const entries = await getCollection('caseStudies');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

export interface Props {
  entry: CollectionEntry<'caseStudies'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, tags, preset, heroImage, heroAlt, summaryRows } = entry.data;

const transitionName = `case-hero-${entry.id}`;

const layoutMeta = {
  '01': { imgWidth: 1920, imgHeight: 1080, aspect: 'aspect-video' },
  '02': { imgWidth: 1080, imgHeight: 1080, aspect: 'aspect-square' },
  '03': { imgWidth: 1200, imgHeight: 1600, aspect: 'aspect-[3/4]' },
  '04': { imgWidth: 1000, imgHeight: 1250, aspect: 'aspect-[4/5]' },
} as const;

const L = layoutMeta[preset];

const heroImageTransitionAttrs = { 'transition:name': transitionName } as const;

const allCaseEntries = await getCollection('caseStudies');
const sortedForNav = [...allCaseEntries].sort((a, b) => {
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return a.id.localeCompare(b.id);
});

const tocRoots = tocFromMarkdownHeadings(entry.body ?? '');

const relatedItems = sortedForNav
  .filter((e) => e.id !== entry.id)
  .map((e) => ({
    href: `/portfolio/work/${e.id}`,
    title: e.data.title,
    listNumber: String(sortedForNav.findIndex((x) => x.id === e.id) + 1).padStart(2, '0'),
  }));

const caseStudyDetailHeader = {
  brand: '植田 一貴',
  caseStudyTitle: title,
  aboutHref: '/about',
  tags,
} satisfies CaseStudyDetailHeaderProps;
---

<PortfolioLayout title={`${title} | kazkiueda.com`} caseStudyDetailHeader={caseStudyDetailHeader}>
  <main
    id="main-content"
    class="mx-auto min-w-0 pb-32 pt-[var(--case-study-detail-main-pad-top)] md:pb-48"
    transition:animate="slide"
  >
    <div class="mx-auto max-w-[1440px] px-6 lg:px-[72px]">
      <div
        class="mx-auto grid max-w-[1296px] grid-cols-1 gap-y-12 lg:grid-cols-[240px_minmax(0,720px)_296px] lg:gap-x-5 lg:gap-y-0"
      >
        <div class="hidden min-w-0 lg:block">
          <CaseStudyDetailToc roots={tocRoots} />
        </div>

        <article class="min-w-0" aria-labelledby="case-study-lead">
          <p
            id="case-study-lead"
            class="m-0 text-base leading-relaxed text-fg-muted md:text-lg"
          >
            {description}
          </p>

          <div
            class:list={[
              'relative mt-8 w-full overflow-hidden rounded-xl border border-border-subtle bg-surface-subtle forced-colors:border forced-colors:border-CanvasText',
              L.aspect,
            ]}
          >
            <Image
              src={heroImage}
              alt={heroAlt}
              width={L.imgWidth}
              height={L.imgHeight}
              class="h-full w-full object-cover opacity-[0.98] transition-opacity duration-500"
              sizes="(min-width: 1024px) 720px, 100vw"
              {...heroImageTransitionAttrs}
            />
          </div>

          <div
            class="mt-10 overflow-hidden rounded-2xl border border-border-subtle bg-surface-subtle/50"
            aria-label="概要"
          >
            {
              summaryRows.map((row) => (
                <div
                  class="grid grid-cols-1 gap-2 border-b border-border-subtle px-4 py-3 last:border-b-0 sm:grid-cols-[120px_1fr] sm:gap-6 sm:px-6"
                >
                  <div class="text-sm font-medium text-fg-strong">{row.label}</div>
                  <div class="min-w-0 text-sm leading-relaxed text-fg-muted">{row.value}</div>
                </div>
              ))
            }
          </div>

          <div
            class:list={[
              'prose prose-neutral prose-lg mt-12 max-w-none text-fg-muted',
              'prose-headings:scroll-mt-40 prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-fg-strong prose-headings:normal-case',
              'prose-h2:mb-3 prose-h2:mt-10 prose-h2:text-lg prose-h2:text-fg-strong first:prose-h2:mt-12',
              'prose-p:leading-relaxed prose-strong:text-fg-strong prose-a:text-accent prose-a:font-medium',
            ]}
          >
            <Content />
          </div>
        </article>

        <div class="hidden min-w-0 lg:block">
          <CaseStudyDetailRelated items={relatedItems} />
        </div>
      </div>
    </div>
  </main>
  <CaseStudyDetailTocScrollSpy />
</PortfolioLayout>
