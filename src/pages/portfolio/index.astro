---
export const prerender = true;

import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import PortfolioCaseStudy from '../../components/portfolio/PortfolioCaseStudy.astro';
import PortfolioFooter from '../../components/portfolio/PortfolioFooter.astro';
import type {
  CaseStudy,
  FooterLink,
  PortfolioListingHeaderProps,
} from '../../components/portfolio/portfolio-types';

/** 一覧カード用: ビューポートに合わせた解像度だけ生成してペイロードを抑える */
function caseListingImageWidths(maxWidth: number): number[] {
  const steps = [640, 750, 828, 960, 1080, 1280, 1536, 1920];
  const out = steps.filter((w) => w <= maxWidth);
  if (!out.includes(maxWidth)) out.push(maxWidth);
  return [...new Set(out)].sort((a, b) => a - b);
}

const rawEntries = await getCollection('caseStudies');
const sorted = [...rawEntries].sort((a, b) => {
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return a.id.localeCompare(b.id);
});

/** 一覧サムネは正方形・実表示は ~16rem 相当のため 1:1 で十分な解像度に抑える */
const LISTING_THUMB = { w: 720, h: 720 } as const;

const caseStudies: CaseStudy[] = await Promise.all(
  sorted.map(async (entry, rowIndex) => {
    const { heroImage, heroAlt, order: _order, ...data } = entry.data;
    const imageSizes =
      '(max-width: 1023px) min(calc(100vw - 3rem), 15rem), 16rem';
    const optimized = await getImage({
      src: heroImage,
      width: LISTING_THUMB.w,
      height: LISTING_THUMB.h,
      widths: caseListingImageWidths(LISTING_THUMB.w),
      sizes: imageSizes,
    });
    return {
      ...data,
      imageSrc: optimized.src,
      imageSrcset: optimized.srcSet.attribute,
      imageSizes,
      imageAlt: heroAlt,
      sectionId: `case-${entry.id}`,
      href: `/portfolio/work/${entry.id}`,
      transitionName: `case-hero-${entry.id}`,
      rowIndex,
    };
  }),
);

const footerLinks: FooterLink[] = [
  {
    label: 'Instagram',
    href: import.meta.env.PUBLIC_INSTAGRAM_URL?.trim() || undefined,
  },
  {
    label: 'LinkedIn',
    href: import.meta.env.PUBLIC_LINKEDIN_URL?.trim() || undefined,
  },
  {
    label: 'Dribbble',
    href: import.meta.env.PUBLIC_DRIBBBLE_URL?.trim() || undefined,
  },
];

const portfolioListingHeader = {
  brand: '植田 一貴',
  tagline: 'ポートフォリオ',
  aboutHref: '/about',
} satisfies PortfolioListingHeaderProps;
---

<PortfolioLayout title="Portfolio | kazkiueda.com" portfolioListingHeader={portfolioListingHeader}>
  <main
    id="main-content"
    class="mx-auto min-w-0 max-w-[1440px] px-6 pb-32 pt-24 lg:px-[72px] md:pb-48 md:pt-28"
  >
    <h1 class="sr-only">植田 一貴のポートフォリオ</h1>

    <section class="relative" aria-labelledby="case-studies-heading">
      <div class="mb-16 min-w-0 md:mb-24">
        <h2 id="case-studies-heading" class="text-3xl font-bold tracking-tight text-fg-strong">
          ケーススタディ
        </h2>
        <div class="mt-3 h-px w-14 bg-border-default" aria-hidden="true"></div>
      </div>

      <div class="flex min-w-0 w-full flex-col gap-y-24 md:gap-y-32 lg:gap-y-40">
        {caseStudies.map((study) => (
          <PortfolioCaseStudy {...study} />
        ))}
      </div>
    </section>
  </main>

  <PortfolioFooter copyright="© 2026 Kazki Ueda. All rights reserved." links={footerLinks} />
</PortfolioLayout>
