const caseStudies: CaseStudy[] = [
  {
    preset: '01',
    tags: ['E-commerce', 'Visual Strategy'],
    title: 'Ether Store',
    description:
      'A complete redesign focusing on high-end visual storytelling and seamless checkout flows for boutique fashion.',
    imageSrc: images.ether,
    imageAlt:
      'Minimalist fashion boutique interior with high ceilings, soft natural light, and clean white shelving displays',
  },
  {
    preset: '02',
    tags: ['SaaS', 'Data Viz'],
    title: 'Nexus Data',
    description:
      'Simplifying complex analytical workflows into an intuitive dashboard system for enterprise cloud management.',
    imageSrc: images.nexus,
    imageAlt:
      'Abstract visualization of digital data points and connections in a clean, soft sage and white color palette',
  },
  {
    preset: '03',
    tags: ['Architecture', 'Motion'],
    title: 'Linear Studio',
    description:
      'Capturing the movement of space through interactive transitions and spatial UI for an award-winning firm.',
    imageSrc: images.linear,
    imageAlt:
      'Close up of modern brutalist architecture with sharp shadows and soft morning light hitting concrete surfaces',
  },
  {
    preset: '04',
    tags: ['Fintech', 'UX Research'],
    title: 'Vera Finance',
    description:
      'Humanizing personal finance with soft typography and a research-backed user experience.',
    imageSrc: images.vera,
    imageAlt:
      'Clean minimalist workspace with a single ceramic mug and a thin laptop, diffused light from a nearby window',
  },
];

const footerLinks: FooterLink[] = [
  {
    label: 'Instagram',
    href: import.meta.env.PUBLIC_INSTAGRAM_URL?.trim() || undefined,
  },
  {
    label: 'LinkedIn',
    href: import.meta.env.PUBLIC_LINKEDIN_URL?.trim() || undefined,
  },
  {
    label: 'Dribbble',
    href: import.meta.env.PUBLIC_DRIBBBLE_URL?.trim() || undefined,
  },
];

const aboutParagraphs = [
  'With a decade of experience across digital landscapes, I focus on the emotional resonance of the interface. Architecture for the screen.',
  'Currently based in the quiet corners of digital space, partnering with brands that value the intentionality of the silent architect.',
];
---

<PortfolioLayout title="Portfolio | kazkiueda.com">
  <main
    id="main-content"
    class="mx-auto min-w-0 max-w-portfolio px-6 pt-20 pb-32 md:px-12 md:pt-28 md:pb-48"
  >
    <PortfolioHero
      titleLine1="Digital experiences"
      titleAccent="carved in silence."
      lead="A text-first approach to interface design. Prioritizing rhythm, hierarchy, and the subtle interplay of light and void."
    />

    <section id="work" class="relative" aria-labelledby="work-heading">
      <h2 id="work-heading" class="sr-only">Selected work</h2>
      <div class="grid min-w-0 grid-cols-1 gap-y-24 md:grid-cols-12 md:gap-y-64">
        {caseStudies.map((study) => <PortfolioCaseStudy {...study} />)}
      </div>
    </section>

    <PortfolioAbout
      portraitSrc={images.portrait}
      portraitAlt="Portrait-style photograph used as an about-section visual (desaturated treatment)"
      quoteBefore='"I believe design should be '
      quoteHighlight="felt"
      quoteAfter=', not just seen."'
      paragraphs={aboutParagraphs}
      storyHref="#contact"
      storyLabel="Read the full story"
    />

    <PortfolioContact email={contactEmail} />
  </main>

  <PortfolioFooter copyright="© 2026 Kazki Ueda. All rights reserved." links={footerLinks} />
</PortfolioLayout>
