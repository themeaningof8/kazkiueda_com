---
export const prerender = false;

import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import PortfolioHero from '../../components/portfolio/PortfolioHero.astro';
import PortfolioCaseStudy from '../../components/portfolio/PortfolioCaseStudy.astro';
import PortfolioAbout from '../../components/portfolio/PortfolioAbout.astro';
import PortfolioContact from '../../components/portfolio/PortfolioContact.astro';
import PortfolioFooter from '../../components/portfolio/PortfolioFooter.astro';
import type {
  CaseStudy,
  CaseStudyNavItem,
  FooterLink,
  PortfolioTopNavProps,
} from '../../components/portfolio/portfolio-types';

const contactEmail =
  import.meta.env.PUBLIC_CONTACT_EMAIL?.trim() || 'hello@kazkiueda.com';

const portraitSrc =
  'https://lh3.googleusercontent.com/aida-public/AB6AXuB5VDClSm4KRAxtpm8kue7xUbl1G-ksEtVO4ROrWO9sLvWDSkww4tSNQSB51ytU_G7_lD2oWPbAIYAvw_8zBzVigzZ626J1Jwl6G4rW2qxyPuciqam7mOphTZ3M44Bh22jLIw_CFhK993qnNGDY_Xo_iBNjbSPeWmYWLxBF7srzGy23G9uvKexbFqcX22Q2UebBq77gDHYUoiJUEeWDuY6Dlq0QIxQ25q4Wx2rC1gvgAHvqDyfI62jV41wIxUF75fkeqYD9FeLR43A';

const rawEntries = await getCollection('caseStudies');
const sorted = [...rawEntries].sort((a, b) => {
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return a.id.localeCompare(b.id);
});

const caseStudies: CaseStudy[] = await Promise.all(
  sorted.map(async (entry, rowIndex) => {
    const { heroImage, heroAlt, order: _order, ...data } = entry.data;
    const dims =
      data.preset === '01'
        ? { w: 1920, h: 1080 }
        : data.preset === '02'
          ? { w: 1080, h: 1080 }
          : data.preset === '03'
            ? { w: 1200, h: 1600 }
            : { w: 1000, h: 1250 };
    const optimized = await getImage({ src: heroImage, width: dims.w, height: dims.h });
    return {
      ...data,
      imageSrc: optimized.src,
      imageAlt: heroAlt,
      sectionId: `case-${entry.id}`,
      href: `/portfolio/work/${entry.id}`,
      transitionName: `case-hero-${entry.id}`,
      rowIndex,
    };
  }),
);

const navItems: CaseStudyNavItem[] = sorted.map((entry) => ({
  anchorId: `case-${entry.id}`,
  label: entry.data.title,
  mono: entry.data.preset,
}));

const footerLinks: FooterLink[] = [
  {
    label: 'Instagram',
    href: import.meta.env.PUBLIC_INSTAGRAM_URL?.trim() || undefined,
  },
  {
    label: 'LinkedIn',
    href: import.meta.env.PUBLIC_LINKEDIN_URL?.trim() || undefined,
  },
  {
    label: 'Dribbble',
    href: import.meta.env.PUBLIC_DRIBBBLE_URL?.trim() || undefined,
  },
];

const aboutIntroParagraphs = [
  '私はチームのボトルネックを見つけ、自分がそこを埋めにいくデザイナーです。',
  'デザイン・実装・事業戦略の三層を行き来しながら、「誰かがやらないと止まる」場所に自分から入っていくことでキャリアを作ってきました。',
];

const aboutSections = [
  {
    heading: '原点となるエピソード',
    paragraphs: [
      '入社直後、デザイン組織のスキル水準は高くなく、フロントエンドを担える人間がいなかったためエンジニアがビュー実装を兼務していました。エンジニアは他の開発タスクを多く抱えており、テスト実装の優先度を巡る摩擦が常態化していた状態です。',
      '私はこの構造をボトルネックと判断し、フロントエンドを自分でキャッチアップすることにしました。Symfony・Ruby on Railsのビュー実装から始め、jQuery、TypeScript、Reactへと段階的に習得。デザイナーとして実装を担えるようになった結果、施策のテスト本数は週2本から最大8本に増加。インタラクティブな実装案を施策の選択肢に加えられるようになり、チームの生産性と表現の幅が同時に広がりました。',
      'その後も炎上気味だったプロジェクトのスクラムマスターに手を挙げたり、デザインシステムの構築を自ら提案・推進したりと、「自分が動けば前に進む」と判断した場所に一貫して入ってきました。',
    ],
  },
  {
    heading: '私が提供できること',
    bullets: [
      'デザインと実装の両側から課題を定義し、解決策を作る',
      'ステークホルダー間の認識ズレを構造化し、合意形成につなげる',
      'チームに不足しているケイパビリティを見極め、自分がそこを埋める',
    ],
  },
];

const aboutClosing =
  '肩書きはデザイナーですが、組織が前に進むために必要なことをやる人間だと自己認識しています。';

const aboutSkillTags = ['デザインストラテジー', 'システム設計', 'アジャイルリーダーシップ'];

const topNav = {
  brand: 'Kazki Ueda',
  workHref: '#work',
  aboutHref: '#about',
  contactHref: '#contact',
  ctaHref: `mailto:${contactEmail}`,
  ctaLabel: 'お問い合わせ',
  caseNavItems: navItems,
} satisfies PortfolioTopNavProps;
---

<PortfolioLayout title="Portfolio | kazkiueda.com" topNav={topNav}>
  <main
    id="main-content"
    class="mx-auto min-w-0 max-w-portfolio px-6 pb-32 pt-28 md:px-12 md:pb-48 md:pt-32"
  >
    <PortfolioHero
      titleLine1="静かな画面に、"
      titleAccent="体験を刻む。"
      lead="リズムと階層、光と余白の関係性を大切にする、テキスト起点のインターフェースデザインです。"
    />

    <section id="work" class="relative scroll-mt-28 md:scroll-mt-32" aria-labelledby="work-heading">
      <div class="mb-16 min-w-0 md:mb-24">
        <h2 id="work-heading" class="text-3xl font-bold tracking-tight text-fg-strong">
          Selected Works
        </h2>
        <div class="mt-2 h-1 w-12 bg-accent" aria-hidden="true"></div>
      </div>

      <div class="flex min-w-0 w-full flex-col gap-y-24 md:gap-y-32 lg:gap-y-40">
        {caseStudies.map((study) => (
          <PortfolioCaseStudy {...study} />
        ))}
      </div>
    </section>

    <PortfolioAbout
      portraitSrc={portraitSrc}
      portraitAlt="自己紹介セクション用のポートレート写真（低彩度・グレースケール加工）"
      introParagraphs={aboutIntroParagraphs}
      sections={aboutSections}
      closingParagraph={aboutClosing}
      eyebrow="About"
      skillTags={aboutSkillTags}
    />

    <PortfolioContact email={contactEmail} />
  </main>

  <PortfolioFooter copyright="© 2026 Kazki Ueda. All rights reserved." links={footerLinks} />
</PortfolioLayout>
