---
import type { PortfolioTopNavProps } from './portfolio-types';

type Props = PortfolioTopNavProps;

const { brand, workHref, aboutHref, contactHref, ctaHref, ctaLabel } = Astro.props;
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-border-subtle bg-surface-canvas/80 backdrop-blur-md"
>
  <div
    class="mx-auto flex h-14 max-w-portfolio items-center justify-between gap-4 px-6 md:h-16 md:px-12"
  >
    <a
      href="/portfolio"
      class="min-w-0 shrink truncate text-sm font-semibold tracking-tight text-fg-strong transition-colors hover:text-fg-muted md:text-base"
    >
      {brand}
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="ページ内">
      <a
        href={workHref}
        class="text-sm tracking-wide text-fg-muted transition-colors hover:text-fg-strong"
      >
        制作実績
      </a>
      <a
        href={aboutHref}
        class="text-sm tracking-wide text-fg-muted transition-colors hover:text-fg-strong"
      >
        について
      </a>
      <a
        href={contactHref}
        class="text-sm tracking-wide text-fg-muted transition-colors hover:text-fg-strong"
      >
        連絡
      </a>
    </nav>

    <a
      href={ctaHref}
      class="shrink-0 rounded-lg bg-accent px-3 py-2 text-xs font-semibold text-fg-on-accent transition-colors hover:bg-accent-hover md:px-4 md:text-sm"
    >
      {ctaLabel}
    </a>
  </div>
</header>
