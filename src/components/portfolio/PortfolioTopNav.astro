---
import type { PortfolioTopNavProps } from './portfolio-types';
import PortfolioCaseStudyScrollSpy from './PortfolioCaseStudyScrollSpy.astro';
import PortfolioWorkNavPopover from './PortfolioWorkNavPopover.astro';

type Props = PortfolioTopNavProps;

const {
  brand,
  workHref,
  aboutHref,
  contactHref,
  ctaHref,
  ctaLabel,
  caseNavItems,
} = Astro.props;

const hasCaseNav = Boolean(caseNavItems?.length);
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-border-subtle bg-surface-canvas"
>
  <div class="mx-auto max-w-portfolio">
    <div
      class="flex h-14 items-center justify-between gap-4 px-6 md:h-16 md:px-12"
    >
      <a
        href="/case-study"
        class="min-w-0 shrink truncate text-sm font-semibold tracking-tight text-fg-strong transition-colors hover:text-fg-muted md:text-base"
      >
        {brand}
      </a>

      <nav class="hidden items-center gap-8 md:flex" aria-label="ページ内">
        {
          hasCaseNav && caseNavItems ? (
            <PortfolioWorkNavPopover workHref={workHref} items={caseNavItems} />
          ) : (
            <a
              href={workHref}
              class="text-sm tracking-wide text-fg-muted transition-colors hover:text-fg-strong"
            >
              制作実績
            </a>
          )
        }
        <a
          href={aboutHref}
          class="text-sm tracking-wide text-fg-muted transition-colors hover:text-fg-strong"
        >
          について
        </a>
        <a
          href={contactHref}
          class="text-sm tracking-wide text-fg-muted transition-colors hover:text-fg-strong"
        >
          連絡
        </a>
      </nav>

      <a
        href={ctaHref}
        class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg bg-accent-surface px-4 py-2 text-xs font-semibold text-fg-on-accent transition-colors hover:bg-accent-surface-hover md:px-5 md:text-sm"
      >
        {ctaLabel}
      </a>
    </div>

    <nav
      class="border-t border-border-subtle px-6 pb-3 pt-2 md:hidden"
      aria-label="ページ内ナビゲーション"
    >
      <ul class="flex flex-wrap items-center gap-x-1 gap-y-1">
        <li>
          <a
            href={workHref}
            class="inline-flex min-h-11 items-center rounded-md px-3 text-sm tracking-wide text-fg-muted transition-colors hover:bg-surface-ui hover:text-fg-strong"
          >
            制作実績
          </a>
        </li>
        <li>
          <a
            href={aboutHref}
            class="inline-flex min-h-11 items-center rounded-md px-3 text-sm tracking-wide text-fg-muted transition-colors hover:bg-surface-ui hover:text-fg-strong"
          >
            について
          </a>
        </li>
        <li>
          <a
            href={contactHref}
            class="inline-flex min-h-11 items-center rounded-md px-3 text-sm tracking-wide text-fg-muted transition-colors hover:bg-surface-ui hover:text-fg-strong"
          >
            連絡
          </a>
        </li>
      </ul>
    </nav>

    {hasCaseNav ? <PortfolioCaseStudyScrollSpy /> : null}
  </div>
</header>
