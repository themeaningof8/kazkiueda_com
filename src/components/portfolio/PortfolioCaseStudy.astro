---
import PortfolioTag from './PortfolioTag.astro';
import type { CaseStudy } from './portfolio-types';

type Props = CaseStudy;

const {
  preset,
  tags,
  title,
  description,
  roleBadge,
  outcomeLabel,
  outcomeTitle,
  sectionId,
  href,
  linkLabel,
} = Astro.props;

const headingId = `${sectionId}-heading`;
const caseStudyAriaLabel = linkLabel ?? `ケーススタディ: ${title}`;
---

<article class="relative mx-auto w-full min-w-0 max-w-[1296px]" aria-labelledby={headingId}>
  <div
    class="rounded-2xl border border-border-subtle bg-surface-subtle/50 p-6 md:p-8 lg:p-10"
  >
    {
      href ? (
        <div class="flex min-w-0 flex-col gap-4">
          <div class="flex flex-wrap items-start gap-x-5 gap-y-2">
            <span
              class="shrink-0 pt-0.5 text-xs tabular-nums text-fg-muted"
              aria-hidden="true">{preset}</span
            >
            <div class="flex min-w-0 flex-1 flex-wrap gap-2">
              {tags.map((t) => <PortfolioTag label={t} />)}
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <span
              class="rounded border border-border-default bg-surface-ui px-2 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-fg-muted"
              >{roleBadge}</span
            >
          </div>
          <h3
            id={headingId}
            class="min-w-0 max-w-full break-words text-2xl font-bold tracking-tight text-fg-strong md:text-3xl"
          >
            {title}
          </h3>
          <p class="text-sm leading-relaxed text-fg-muted md:text-base">
            {description}
          </p>
          <div
            class="rounded-lg border border-border-subtle bg-surface-subtle p-4"
            aria-label={`${outcomeLabel}: ${outcomeTitle}`}
          >
            <span class="mb-1 block text-xs font-semibold tracking-wide text-fg-muted"
              >{outcomeLabel}</span
            >
            <p class="text-lg font-semibold leading-snug text-fg-strong">{outcomeTitle}</p>
          </div>
          <div class="pt-2">
            <a
              class="group/detail inline-flex items-center gap-2 text-sm font-semibold text-fg-muted underline decoration-border-default underline-offset-4 transition-colors hover:text-accent"
              href={href}
              aria-label={caseStudyAriaLabel}
            >
              <span>{linkLabel ?? 'ケーススタディを見る'}</span>
              <span
                class="material-symbols-outlined text-base transition-transform group-hover/detail:translate-x-1 motion-reduce:transition-none"
                aria-hidden="true">arrow_forward</span
              >
            </a>
          </div>
        </div>
      ) : (
        <div class="space-y-4">
          <div class="flex flex-wrap items-start gap-x-5 gap-y-2">
            <span class="shrink-0 pt-0.5 text-xs tabular-nums text-fg-muted" aria-hidden="true"
              >{preset}</span
            >
            <div class="flex min-w-0 flex-1 flex-wrap gap-2">
              {tags.map((t) => <PortfolioTag label={t} />)}
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <span
              class="rounded border border-border-default bg-surface-ui px-2 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-fg-muted"
              >{roleBadge}</span
            >
          </div>
          <h3 id={headingId} class="min-w-0 max-w-full break-words text-2xl font-bold text-fg-strong">
            {title}
          </h3>
          <p class="text-fg-muted">{description}</p>
          <div
            class="rounded-lg border border-border-subtle bg-surface-subtle p-4"
            aria-label={`${outcomeLabel}: ${outcomeTitle}`}
          >
            <span class="mb-1 block text-xs font-semibold tracking-wide text-fg-muted"
              >{outcomeLabel}</span
            >
            <p class="text-lg font-semibold leading-snug text-fg-strong">{outcomeTitle}</p>
          </div>
        </div>
      )
    }
  </div>
</article>
