---
import { Image } from 'astro:assets';
import PortfolioTag from './PortfolioTag.astro';
import type { CaseStudy } from './portfolio-types';

type Props = CaseStudy;

const {
  tags,
  title,
  description,
  roleBadge,
  outcomeLabel,
  outcomeTitle,
  sectionId,
  href,
  linkLabel,
  rowIndex,
  heroImage,
  listingImage,
  heroAlt,
} = Astro.props;

const headingId = `${sectionId}-heading`;
const cardBackdropImage = listingImage ?? heroImage;
/** 一覧サムネは `transition:name` しない（詳細ヒーローとの共有要素モーフが GPU 負荷でカクつきやすい） */
const showHeroOverlay = Boolean(href && cardBackdropImage && heroAlt);
const isPriorityHero = rowIndex === 0;

/** Paper: 左レールの連番（コレクションの preset はアスペクト用のため一覧では使わない） */
const listNumber = String(rowIndex + 1).padStart(2, '0');
const listDigits = listNumber.split('');
---

<article class="relative mx-auto w-full min-w-0 max-w-[1296px]" aria-labelledby={headingId}>
  <div
    class="relative overflow-hidden rounded-2xl border border-border-subtle bg-surface-subtle/50 p-6 md:p-8 lg:p-10"
  >
    {
      showHeroOverlay ? (
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <Image
            src={cardBackdropImage!}
            alt=""
            width={cardBackdropImage!.width}
            height={cardBackdropImage!.height}
            class="h-full w-full object-cover opacity-[0.22] [filter:grayscale(45%)]"
            sizes="(min-width: 1024px) 1296px, 100vw"
            loading={isPriorityHero ? 'eager' : 'lazy'}
            fetchpriority={isPriorityHero ? 'high' : 'low'}
            transition:animate="none"
          />
          <div class="absolute inset-0 bg-surface-subtle/68"></div>
        </div>
      ) : null
    }
    <div class="relative z-10">
    {
      href ? (
        <div class="flex min-w-0 items-stretch gap-5 md:gap-6">
          <div
            class="flex shrink-0 flex gap-0.5 pt-0.5 text-xl font-bold tabular-nums leading-none tracking-[0.12em] text-fg-muted"
            aria-hidden="true"
          >
            {listDigits.map((d) => <span class="block">{d}</span>)}
          </div>
          <div class="flex min-w-0 flex-1 flex-col gap-4">
            <div class="flex flex-wrap items-center gap-2">
              <span
                class="rounded border border-accent/25 bg-accent/[0.07] px-2 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-accent"
                >{roleBadge}</span
              >
              {tags.map((t) => <PortfolioTag label={t} />)}
            </div>
            <h3
              id={headingId}
              class="min-w-0 max-w-full break-words text-2xl font-bold tracking-tight text-fg-strong md:text-3xl"
              transition:animate="fade"
            >
              {title}
            </h3>
            <p class="text-sm leading-relaxed text-fg-muted md:text-base">
              {description}
            </p>
            <div
              class="rounded-lg border border-accent/30 bg-accent/[0.06] p-4 dark:bg-accent/12"
              aria-label={`${outcomeLabel}: ${outcomeTitle}`}
            >
              <span class="mb-1 block text-xs font-semibold uppercase tracking-[0.18em] text-accent"
                >{outcomeLabel}</span
              >
              <p class="text-lg font-semibold leading-snug text-fg-strong">{outcomeTitle}</p>
            </div>
            <div class="pt-2">
              <a
                class="group/detail inline-flex items-center gap-2 rounded-full bg-accent-surface px-4 py-2.5 text-sm font-semibold text-fg-on-accent shadow-sm outline-none transition-colors hover:bg-accent-surface-hover focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-canvas"
                href={href}
              >
                <span>{linkLabel ?? 'ケーススタディを見る'}</span>
                <span
                  class="material-symbols-outlined text-base text-fg-on-accent transition-transform group-hover/detail:translate-x-0.5 motion-reduce:transition-none"
                  aria-hidden="true">arrow_forward</span
                >
              </a>
            </div>
          </div>
        </div>
      ) : (
        <div class="flex min-w-0 items-stretch gap-5 md:gap-6">
          <div
            class="flex w-[1.625rem] shrink-0 flex-col items-center gap-0.5 pt-0.5 text-xl font-bold tabular-nums leading-none tracking-[0.12em] text-fg-muted"
            aria-hidden="true"
          >
            {listDigits.map((d) => <span class="block">{d}</span>)}
          </div>
          <div class="min-w-0 flex-1 space-y-4">
            <div class="flex flex-wrap items-center gap-2">
              <span
                class="rounded border border-accent/25 bg-accent/[0.07] px-2 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-accent"
                >{roleBadge}</span
              >
              {tags.map((t) => <PortfolioTag label={t} />)}
            </div>
            <h3
              id={headingId}
              class="min-w-0 max-w-full break-words text-2xl font-bold text-fg-strong"
              transition:animate="fade"
            >
              {title}
            </h3>
            <p class="text-fg-muted">{description}</p>
            <div
              class="rounded-lg border border-accent/30 bg-accent/[0.06] p-4 dark:bg-accent/12"
              aria-label={`${outcomeLabel}: ${outcomeTitle}`}
            >
              <span class="mb-1 block text-xs font-semibold uppercase tracking-[0.18em] text-accent"
                >{outcomeLabel}</span
              >
              <p class="text-lg font-semibold leading-snug text-fg-strong">{outcomeTitle}</p>
            </div>
          </div>
        </div>
      )
    }
    </div>
  </div>
</article>
