---
import PortfolioTag from './PortfolioTag.astro';
import type { CaseStudyPreset } from './portfolio-types';

interface Props {
  preset: CaseStudyPreset;
  tags: string[];
  title: string;
  description: string;
  imageSrc: string;
  imageAlt: string;
  sectionId: string;
  href?: string;
  linkLabel?: string;
  transitionName?: string;
}

const {
  preset,
  tags,
  title,
  description,
  imageSrc,
  imageAlt,
  sectionId,
  href,
  linkLabel,
  transitionName,
} = Astro.props;

const headingId = `case-study-heading-${preset}`;

const caseStudyAriaLabel = linkLabel ?? `ケーススタディ: ${title}`;

const linkedImageTransitionAttrs = transitionName
  ? ({ 'transition:name': transitionName } as const)
  : {};

const cardLinkClass =
  'group flex flex-col gap-6 rounded-xl outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-canvas';

const layout = {
  '01': {
    grid: 'md:col-span-7 md:col-start-1',
    number:
      'pointer-events-none absolute -top-16 -left-6 z-[-1] select-none text-[8rem] font-bold text-surface-ui-hover opacity-50 md:-top-20 md:-left-10 md:text-[14rem]',
    title: 'text-4xl md:text-7xl',
    desc: 'max-w-md',
    aspect: 'aspect-video',
    imgWidth: 1920,
    imgHeight: 1080,
  },
  '02': {
    grid: 'md:col-span-5 md:col-start-7 md:mt-48',
    number:
      'pointer-events-none absolute -top-12 -right-4 z-[-1] w-full select-none text-right text-[7rem] font-bold text-surface-ui-hover opacity-50 md:-top-16 md:-right-6 md:text-[12rem]',
    title: 'text-3xl md:text-6xl',
    desc: 'max-w-sm',
    aspect: 'aspect-square',
    imgWidth: 1080,
    imgHeight: 1080,
  },
  '03': {
    grid: 'md:col-span-6 md:col-start-2',
    number:
      'pointer-events-none absolute -top-16 -left-4 z-[-1] select-none text-[8rem] font-bold text-surface-ui-hover opacity-50 md:-top-20 md:-left-12 md:text-[14rem]',
    title: 'text-4xl md:text-7xl',
    desc: 'max-w-md',
    aspect: 'aspect-[3/4]',
    imgWidth: 1200,
    imgHeight: 1600,
  },
  '04': {
    grid: 'md:col-span-5 md:col-start-8 md:-mt-24',
    number:
      'pointer-events-none absolute -top-12 -right-2 z-[-1] w-full select-none text-right text-[7rem] font-bold text-surface-ui-hover opacity-50 md:-top-16 md:-right-4 md:text-[12rem]',
    title: 'text-3xl md:text-6xl',
    desc: 'max-w-sm',
    aspect: 'aspect-[4/5]',
    imgWidth: 1000,
    imgHeight: 1250,
  },
} as const;

const L = layout[preset];

const imageShellClass = [
  'relative w-full overflow-hidden bg-surface-subtle transition-colors duration-500 group-hover:bg-surface-ui-hover forced-colors:border forced-colors:border-CanvasText',
  L.aspect,
];
---

<article
  id={sectionId}
  class:list={['relative min-w-0 scroll-mt-24 md:scroll-mt-32', L.grid]}
  aria-labelledby={headingId}
>
  <span class={L.number} aria-hidden="true">{preset}</span>
  <div class="group min-w-0 space-y-6">
    <div class="mb-4 flex flex-wrap gap-3">
      {tags.map((t) => <PortfolioTag label={t} />)}
    </div>
    {
      href ? (
        <>
          <h3
            id={headingId}
            class:list={[
              'min-w-0 break-words font-bold tracking-tight text-fg-strong transition-colors duration-500 group-hover:text-accent',
              L.title,
            ]}
          >
            {title}
          </h3>
          <p
            class:list={[
              'min-w-0 break-words text-base leading-relaxed text-fg-muted',
              L.desc,
            ]}
          >
            {description}
          </p>
          <a class={cardLinkClass} href={href} aria-label={caseStudyAriaLabel}>
            <div class:list={imageShellClass}>
              <img
                class="h-full w-full object-cover opacity-20 mix-blend-multiply transition-opacity duration-500 group-hover:opacity-60 forced-colors:opacity-100 forced-colors:mix-blend-normal"
                src={imageSrc}
                alt=""
                width={L.imgWidth}
                height={L.imgHeight}
                loading="lazy"
                decoding="async"
                {...linkedImageTransitionAttrs}
              />
            </div>
          </a>
          <div class="pt-1">
            <a
              class="group/detail inline-flex items-center gap-3 self-start outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-canvas"
              href={href}
            >
              <span
                class="border-b-2 border-surface-ui text-base font-bold text-accent transition-all group-hover/detail:border-accent"
                >{linkLabel ?? '詳細を見る'}</span
              >
              <span
                class="material-symbols-outlined text-base text-accent transition-transform group-hover/detail:translate-x-2"
                aria-hidden="true">arrow_forward</span
              >
            </a>
          </div>
        </>
      ) : (
        <div class="group flex min-w-0 flex-col gap-6">
          <h3
            id={headingId}
            class:list={[
              'min-w-0 break-words font-bold tracking-tight text-fg-strong transition-colors duration-500 group-hover:text-accent',
              L.title,
            ]}
          >
            {title}
          </h3>
          <p
            class:list={[
              'min-w-0 break-words text-base leading-relaxed text-fg-muted',
              L.desc,
            ]}
          >
            {description}
          </p>
          <div class:list={imageShellClass}>
            <img
              class="h-full w-full object-cover opacity-20 mix-blend-multiply transition-opacity duration-500 group-hover:opacity-60 forced-colors:opacity-100 forced-colors:mix-blend-normal"
              src={imageSrc}
              alt={imageAlt}
              width={L.imgWidth}
              height={L.imgHeight}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      )
    }
  </div>
</article>
