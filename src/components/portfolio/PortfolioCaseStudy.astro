---
import PortfolioTag from './PortfolioTag.astro';
import type { CaseStudy, CaseStudyPreset } from './portfolio-types';

type Props = CaseStudy;

const {
  preset,
  tags,
  title,
  description,
  roleBadge,
  outcomeLabel,
  outcomeTitle,
  rowIndex,
  imageSrc,
  imageSrcset,
  imageSizes,
  imageAlt,
  sectionId,
  href,
  linkLabel,
  transitionName,
} = Astro.props;

const headingId = `${sectionId}-heading`;
const caseStudyAriaLabel = linkLabel ?? `ケーススタディ: ${title}`;
const reverse = rowIndex % 2 === 1;

const linkedImageTransitionAttrs = transitionName
  ? ({ 'transition:name': transitionName } as const)
  : {};

const layout = {
  '01': { aspect: 'aspect-video', imgWidth: 1920, imgHeight: 1080 },
  '02': { aspect: 'aspect-square', imgWidth: 1080, imgHeight: 1080 },
  '03': { aspect: 'aspect-[3/4]', imgWidth: 1200, imgHeight: 1600 },
  '04': { aspect: 'aspect-[4/5]', imgWidth: 1000, imgHeight: 1250 },
} as const satisfies Record<
  CaseStudyPreset,
  { aspect: string; imgWidth: number; imgHeight: number }
>;

const L = layout[preset];

const numberClass = reverse
  ? 'pointer-events-none absolute -top-16 right-0 z-0 w-full select-none text-right text-[6.5rem] font-semibold leading-none text-surface-ui-hover/25 md:-top-24 md:text-[11rem]'
  : 'pointer-events-none absolute -top-16 left-0 z-0 select-none text-[6.5rem] font-semibold leading-none text-surface-ui-hover/25 md:-top-24 md:text-[11rem]';

const imageShellClass = [
  'relative w-full overflow-hidden rounded-xl bg-surface-subtle forced-colors:border forced-colors:border-CanvasText',
  L.aspect,
];

const imgMotionClass =
  'h-full w-full object-cover grayscale opacity-90 transition-[opacity,transform,filter] duration-500 ease-out group-hover/img:scale-[1.02] group-hover/img:grayscale-0 motion-reduce:transition-none motion-reduce:group-hover/img:scale-100 forced-colors:grayscale-0 forced-colors:opacity-100';
---

<article
  id={sectionId}
  class="relative min-w-0 scroll-mt-28 md:scroll-mt-32"
  aria-labelledby={headingId}
>
  <div class:list={['relative grid grid-cols-12 gap-x-6 gap-y-8 md:gap-x-8 md:gap-y-10 lg:gap-x-10 lg:gap-y-8']}>
    <span class={numberClass} aria-hidden="true">{preset}</span>

    {
      href ? (
        <>
          <div
            class:list={[
              'col-span-12 min-w-0 w-full max-w-xl sm:max-w-2xl md:max-w-3xl lg:max-w-none',
              reverse
                ? 'order-1 mx-auto lg:order-2 lg:mx-0 lg:col-span-5 lg:col-start-8'
                : 'mx-auto lg:mx-0 lg:col-span-5',
            ]}
          >
            <a
              class="group/img block outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-canvas"
              href={href}
              aria-label={caseStudyAriaLabel}
            >
              <div class:list={[imageShellClass, 'group-hover/img:shadow-sm']}>
                <img
                  class={imgMotionClass}
                  src={imageSrc}
                  srcset={imageSrcset}
                  sizes={imageSizes}
                  alt=""
                  width={L.imgWidth}
                  height={L.imgHeight}
                  loading="lazy"
                  decoding="async"
                  {...linkedImageTransitionAttrs}
                />
              </div>
            </a>
          </div>

          <div
            class:list={[
              'col-span-12 flex min-w-0 flex-col justify-center gap-4',
              reverse
                ? 'order-2 lg:order-1 lg:col-span-6 lg:col-start-1'
                : 'lg:col-span-6 lg:col-start-7',
            ]}
          >
            <div class="flex flex-wrap items-center gap-2">
              <span
                class="rounded border border-border-default bg-surface-ui px-2 py-1 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-fg-muted"
                >{roleBadge}</span
              >
            </div>
            <div class="flex flex-wrap gap-2">
              {tags.map((t) => <PortfolioTag label={t} />)}
            </div>
            <h3
              id={headingId}
              class="min-w-0 max-w-full break-words text-2xl font-bold tracking-tight text-fg-strong md:text-3xl"
            >
              {title}
            </h3>
            <p class="max-w-xl text-sm leading-relaxed text-fg-muted md:text-base">
              {description}
            </p>
            <div
              class="rounded-lg border border-border-subtle bg-surface-subtle p-4"
              aria-label={`${outcomeLabel}: ${outcomeTitle}`}
            >
              <span class="mb-1 block text-xs font-semibold tracking-wide text-fg-muted"
                >{outcomeLabel}</span
              >
              <p class="text-lg font-semibold leading-snug text-fg-strong">{outcomeTitle}</p>
            </div>
            <div class="pt-2">
              <a
                class="group/detail inline-flex items-center gap-2 text-sm font-semibold text-fg-muted underline decoration-border-default underline-offset-4 transition-colors hover:text-accent"
                href={href}
              >
                <span>{linkLabel ?? 'ケーススタディを見る'}</span>
                <span
                  class="material-symbols-outlined text-base transition-transform group-hover/detail:translate-x-1 motion-reduce:transition-none"
                  aria-hidden="true">arrow_forward</span
                >
              </a>
            </div>
          </div>
        </>
      ) : (
        <div class="col-span-12 mx-auto w-full max-w-xl space-y-4 sm:max-w-2xl md:max-w-3xl lg:max-w-none">
          <h3 id={headingId} class="min-w-0 max-w-full break-words text-2xl font-bold text-fg-strong">
            {title}
          </h3>
          <p class="text-fg-muted">{description}</p>
          <div class:list={imageShellClass}>
            <img
              class={imgMotionClass}
              src={imageSrc}
              srcset={imageSrcset}
              sizes={imageSizes}
              alt={imageAlt}
              width={L.imgWidth}
              height={L.imgHeight}
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      )
    }
  </div>
</article>
