---
export interface AboutContentSection {
  heading: string;
  paragraphs?: string[];
  bullets?: string[];
}

interface Props {
  portraitSrc: string;
  portraitAlt: string;
  introParagraphs: string[];
  sections: AboutContentSection[];
  closingParagraph?: string;
  storyHref?: string;
  storyLabel?: string;
}

const {
  portraitSrc,
  portraitAlt,
  introParagraphs,
  sections,
  closingParagraph,
  storyHref,
  storyLabel,
} = Astro.props;

const sectionHeadingBase =
  'scroll-mt-24 text-xl font-bold tracking-tight text-fg-strong md:text-2xl';
const bodyClass = 'mt-4 max-w-lg min-w-0 space-y-6 text-lg leading-relaxed text-fg-muted';
---

<section
  id="about"
  class="mt-40 grid grid-cols-1 items-start gap-12 md:mt-96 md:grid-cols-12 md:gap-32"
  aria-labelledby="about-heading"
>
  <h2 id="about-heading" class="sr-only">About me</h2>
  <div class="relative md:col-span-4 md:col-start-2">
    <div
      class="relative aspect-[4/5] bg-surface-ui-hover forced-colors:border forced-colors:border-CanvasText"
    >
      <img
        class="h-full w-full object-cover opacity-80 mix-blend-multiply grayscale forced-colors:opacity-100 forced-colors:mix-blend-normal forced-colors:grayscale-0"
        src={portraitSrc}
        alt={portraitAlt}
        width={800}
        height={1000}
        loading="lazy"
        decoding="async"
      />
      <div
        class="pointer-events-none absolute inset-0 border border-surface-canvas border-[length:var(--spacing-portfolio-frame-sm)] md:border-[length:var(--spacing-portfolio-frame-md)]"
      >
      </div>
    </div>
  </div>
  <div class="min-w-0 md:col-span-6">
    <div class={`${bodyClass} max-w-none`}>
      {introParagraphs.map((p) => (
        <p class="min-w-0 break-words">{p}</p>
      ))}
    </div>

    {
      sections.map((section, index) => (
        <div class="min-w-0">
          <h3
            class:list={[
              sectionHeadingBase,
              index === 0 ? 'mt-10 md:mt-14' : 'mt-12 md:mt-16',
            ]}
          >
            {section.heading}
          </h3>
          {section.paragraphs?.length ? (
            <div class={bodyClass}>
              {section.paragraphs.map((p) => (
                <p class="min-w-0 break-words">{p}</p>
              ))}
            </div>
          ) : null}
          {section.bullets?.length ? (
            <ul
              class={`${bodyClass} list-outside list-disc space-y-3 pl-6 marker:text-accent`}
            >
              {section.bullets.map((item) => (
                <li class="min-w-0 break-words pl-1">{item}</li>
              ))}
            </ul>
          ) : null}
        </div>
      ))
    }

    {
      closingParagraph ? (
        <p class="mt-10 max-w-lg min-w-0 break-words text-lg leading-relaxed text-fg-muted md:mt-14">
          {closingParagraph}
        </p>
      ) : null
    }

    {
      storyHref && storyLabel ? (
        <div class="pt-8 md:pt-12">
          <a class="group inline-flex items-center gap-4" href={storyHref}>
            <span
              class="border-b-2 border-surface-ui text-lg font-bold text-accent transition-all group-hover:border-accent"
              >{storyLabel}</span
            >
            <span
              class="material-symbols-outlined text-accent transition-transform group-hover:translate-x-2"
              aria-hidden="true">east</span
            >
          </a>
        </div>
      ) : null
    }
  </div>
</section>
