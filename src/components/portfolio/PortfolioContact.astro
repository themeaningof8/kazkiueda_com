---
interface Props {
  email: string;
  headline?: string;
  subcopy?: string;
  buttonLabel?: string;
}

const {
  email,
  headline = '一緒に、意味のあるものをつくりましょう。',
  subcopy = 'プロジェクトのご相談や採用についてなど、お気軽にご連絡ください。',
  buttonLabel = 'お問い合わせ',
} = Astro.props;
---

<section
  id="contact"
  class="scroll-mt-28 border-y border-border-subtle/40 bg-accent px-6 py-20 text-center text-fg-on-accent md:px-12 md:py-28"
  aria-labelledby="contact-heading"
>
  <div class="mx-auto max-w-3xl">
    <h2
      id="contact-heading"
      class="text-3xl font-bold leading-tight tracking-tighter md:text-5xl"
    >
      {headline}
    </h2>
    <p class="mt-6 text-base font-light text-fg-on-accent/85 md:text-lg">
      {subcopy}
    </p>
    <a
      class="mt-10 inline-block rounded-lg bg-surface-canvas px-10 py-4 text-base font-bold text-accent shadow-lg transition hover:bg-surface-subtle active:scale-[0.98] motion-reduce:transition-none"
      href={`mailto:${email}`}
    >
      {buttonLabel}
    </a>
  </div>
</section>
