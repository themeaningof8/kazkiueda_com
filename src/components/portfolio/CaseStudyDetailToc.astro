---
interface TocLink {
  text: string;
  slug: string;
  href: string;
}

interface Props {
  items: TocLink[];
}

const { items } = Astro.props;
---

<div class="sticky top-28 self-start">
<nav
  class="case-study-detail-toc"
  aria-label="このページのセクション"
>
  <p
    class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-fg-muted"
  >
    On this page
  </p>
  {
    items.length > 0 ? (
      <ul class="mt-4 space-y-2 border-l border-border-subtle pl-4">
        {items.map((item) => (
          <li>
            <a
              data-toc-anchor={item.slug}
              href={item.href}
              class="case-study-toc-link block py-0.5 text-sm text-fg-muted transition-colors hover:text-fg-strong"
            >
              {item.text}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="mt-4 text-sm text-fg-muted">セクション見出しがありません。</p>
    )
  }
</nav>
</div>
