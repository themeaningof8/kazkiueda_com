---
import ThemeToggleButton from './ThemeToggleButton.astro';
import type { PortfolioListingHeaderProps } from './portfolio-types';

type Props = PortfolioListingHeaderProps;

const { brand, tagline, aboutHref, aboutLabel = 'About' } = Astro.props;
---

<header class="fixed inset-x-0 top-0 z-50 bg-surface-canvas" role="banner">
  <div class="mx-auto max-w-[1440px] px-6 lg:px-[72px]">
    <div
      class="flex min-h-[50px] items-center justify-between gap-4 py-2 md:min-h-[50px] md:py-0"
    >
      <div class="min-w-0 flex-1">
        <p class="truncate text-xs text-fg-muted">{brand}</p>
        <p
          class="line-clamp-2 min-w-0 text-sm font-semibold leading-snug text-fg-strong md:text-base"
        >
          {tagline}
        </p>
      </div>
      <div class="flex shrink-0 items-center gap-3">
        <ThemeToggleButton />
        <a
          href={aboutHref}
          class="rounded-sm text-sm font-medium text-accent outline-none transition-colors hover:text-accent focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-canvas"
        >
          {aboutLabel}
        </a>
      </div>
    </div>
  </div>
</header>
