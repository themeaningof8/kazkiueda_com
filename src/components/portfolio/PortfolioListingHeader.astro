---
import ThemeToggleButton from './ThemeToggleButton.astro';
import type { PortfolioListingHeaderProps } from './portfolio-types';

type Props = PortfolioListingHeaderProps;

const { brand, tagline, aboutHref, aboutLabel = 'About', backHref, backLabel = '戻る' } =
  Astro.props;
---

<header class="fixed inset-x-0 top-0 z-50 bg-surface-canvas" role="banner">
  <div class="mx-auto max-w-[1440px] px-6 lg:px-[72px]">
    <div
      class="flex min-h-[50px] items-center justify-between gap-4 py-2 md:min-h-[50px] md:py-0"
    >
      <div class="flex min-w-0 flex-1 items-center">
        {
          backHref && (
            <a
              href={backHref}
              class="u-case-study-detail-back-button-enter"
              data-case-study-back-enter
              aria-label={backLabel}
            >
              <svg
                class="size-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m15 18-6-6 6-6" />
              </svg>
            </a>
          )
        }
        <div class="min-w-0">
          <p class="truncate text-xs text-fg-muted">{brand}</p>
          <p
            class="line-clamp-2 min-w-0 text-sm font-semibold leading-snug text-fg-strong md:text-base"
          >
            {tagline}
          </p>
        </div>
      </div>
      <div class="flex shrink-0 items-center gap-3">
        <ThemeToggleButton />
        <a
          href={aboutHref}
          class="rounded-sm text-sm font-medium text-accent outline-none transition-colors hover:text-accent focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-surface-canvas"
        >
          {aboutLabel}
        </a>
      </div>
    </div>
  </div>
</header>


<script>
  function initCaseStudyDetailHeaderEnterMotion() {
    const back = document.querySelector<HTMLElement>('[data-case-study-back-enter]');
    if (!back) return;

    back.classList.remove('u-case-study-detail-back-button-enter-active');

    void back.offsetWidth;

    requestAnimationFrame(() => {
      back.classList.add('u-case-study-detail-back-button-enter-active');
    });
  }

  initCaseStudyDetailHeaderEnterMotion();
  document.addEventListener('astro:after-swap', initCaseStudyDetailHeaderEnterMotion);
  document.addEventListener('astro:page-load', initCaseStudyDetailHeaderEnterMotion);
</script>
