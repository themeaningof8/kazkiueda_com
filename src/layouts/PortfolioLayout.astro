---
import '../styles/styles.css';
import { ClientRouter } from 'astro:transitions';
import PortfolioTopNav from '../components/portfolio/PortfolioTopNav.astro';
import CaseStudyDetailHeader from '../components/portfolio/CaseStudyDetailHeader.astro';
import type {
  CaseStudyDetailHeaderProps,
  PortfolioTopNavProps,
} from '../components/portfolio/portfolio-types';

interface Props {
  title?: string;
  topNav?: PortfolioTopNavProps;
  /** 指定時は `PortfolioTopNav` の代わりに詳細用ヘッダを表示（`topNav` より優先） */
  caseStudyDetailHeader?: CaseStudyDetailHeaderProps;
}

const { title = 'Portfolio', topNav, caseStudyDetailHeader } = Astro.props;
---

<!doctype html>
<html class="light" lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,300,0,0&display=swap&text=arrow_forwardeast"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-surface-canvas font-sans text-fg-strong selection:bg-surface-ui selection:text-fg-muted"
  >
    <a
      class="fixed z-[100] inline-block translate-y-[calc(-100%-theme(spacing.6))] rounded-lg bg-accent-surface px-4 py-3 font-sans text-sm font-semibold text-fg-on-accent underline outline-offset-2 transition-transform focus:translate-y-0 focus:outline focus:outline-2 focus:outline-fg-strong focus-visible:outline-[3px] forced-colors:focus:outline forced-colors:focus:outline-CanvasText forced-colors:focus-visible:outline-CanvasText"
      href="#main-content">本文へスキップ</a
    >
    {
      caseStudyDetailHeader ? (
        <CaseStudyDetailHeader {...caseStudyDetailHeader} />
      ) : (
        topNav && <PortfolioTopNav {...topNav} />
      )
    }
    <slot />
  </body>
</html>
