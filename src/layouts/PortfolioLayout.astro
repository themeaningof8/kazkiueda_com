---
import '../styles/styles.css';
import { ClientRouter } from 'astro:transitions';
import CaseStudyDetailHeader from '../components/portfolio/CaseStudyDetailHeader.astro';
import PortfolioListingHeader from '../components/portfolio/PortfolioListingHeader.astro';
import type {
  CaseStudyDetailHeaderProps,
  PortfolioListingHeaderProps,
} from '../components/portfolio/portfolio-types';

interface OgMeta {
  description: string;
  url?: string;
}

interface Props {
  title?: string;
  /** 詳細用ヘッダ（`portfolioListingHeader` より優先） */
  caseStudyDetailHeader?: CaseStudyDetailHeaderProps;
  /** 一覧用ヘッダ（`caseStudyDetailHeader` 未指定時のみ） */
  portfolioListingHeader?: PortfolioListingHeaderProps;
  /** ページ単位の OGP / meta description 設定 */
  ogMeta?: OgMeta;
}

const { title = 'Portfolio', caseStudyDetailHeader, portfolioListingHeader, ogMeta } = Astro.props;
---

<!doctype html>
<html class="motion-safe:scroll-smooth" lang="ja" transition:name="root" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        var k = 'kazkiueda-theme';
        var stored = null;
        try {
          if (typeof localStorage !== 'undefined') {
            stored = localStorage.getItem(k);
          }
        } catch (_) {
          stored = null;
        }
        var theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.classList.remove('light', 'dark');
        document.documentElement.classList.add(theme);
        document.documentElement.style.colorScheme = theme === 'dark' ? 'dark' : 'light';
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>{title}</title>
    {ogMeta && <meta name="description" content={ogMeta.description} />}
    {ogMeta && <meta property="og:title" content={title} />}
    {ogMeta && <meta property="og:description" content={ogMeta.description} />}
    {ogMeta && <meta property="og:type" content="article" />}
    {ogMeta?.url && <meta property="og:url" content={ogMeta.url} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,300,0,0&display=swap&text=arrow_forwardeastdark_modelight_mode"
      rel="stylesheet"
    />
  </head>
  <body
    class="bg-surface-canvas font-sans text-fg-strong selection:bg-surface-ui selection:text-fg-muted"
  >
    <a
      class="fixed z-[100] inline-block translate-y-[calc(-100%-theme(spacing.6))] rounded-lg bg-accent-surface px-4 py-3 font-sans text-sm font-semibold text-fg-on-accent underline outline-offset-2 transition-transform focus:translate-y-0 focus:outline focus:outline-2 focus:outline-fg-strong focus-visible:outline-[3px] forced-colors:focus:outline forced-colors:focus:outline-CanvasText forced-colors:focus-visible:outline-CanvasText"
      href="#main-content">本文へスキップ</a
    >
    {
      /* ヘッダは同時に1つ: 詳細 > 一覧 */
      caseStudyDetailHeader ? (
        <CaseStudyDetailHeader {...caseStudyDetailHeader} />
      ) : portfolioListingHeader ? (
        <PortfolioListingHeader {...portfolioListingHeader} />
      ) : null
    }
    <slot />
    <script>
      (function () {
        var KEY = 'kazkiueda-theme';

        /** インライン初期化と同じ規則。View Transitions 後は DOM が差し替わるためここで必ず復元する */
        function applyStoredTheme() {
          var stored = null;
          try {
            if (typeof localStorage !== 'undefined') {
              stored = localStorage.getItem(KEY);
            }
          } catch (_) {
            stored = null;
          }
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          var root = document.documentElement;
          root.classList.remove('light', 'dark');
          root.classList.add(theme);
          root.style.colorScheme = theme === 'dark' ? 'dark' : 'light';
        }

        function syncThemeToggleIcons() {
          var root = document.documentElement;
          var theme = root.classList.contains('dark') ? 'dark' : 'light';
          var iconGlyph = theme === 'dark' ? 'light_mode' : 'dark_mode';
          var label =
            theme === 'dark' ? 'ライトテーマに切り替え' : 'ダークテーマに切り替え';
          document.querySelectorAll('[data-theme-icon]').forEach(function (el) {
            el.textContent = iconGlyph;
          });
          document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
            btn.setAttribute('aria-label', label);
          });
        }

        function onToggleClick(e: Event) {
          var el = e.target;
          if (!(el instanceof Element)) return;
          var btn = el.closest('[data-theme-toggle]');
          if (!btn) return;
          e.preventDefault();
          var root = document.documentElement;
          var next = root.classList.contains('dark') ? 'light' : 'dark';
          root.classList.remove('light', 'dark');
          root.classList.add(next);
          root.style.colorScheme = next === 'dark' ? 'dark' : 'light';
          try {
            localStorage.setItem(KEY, next);
          } catch {
            /* ignore */
          }
          syncThemeToggleIcons();
        }

        function bindThemeToggleUi() {
          applyStoredTheme();
          syncThemeToggleIcons();
        }

        var win = window as Window & { __kazkiThemeToggleUi?: boolean };
        if (!win.__kazkiThemeToggleUi) {
          win.__kazkiThemeToggleUi = true;
          document.addEventListener('click', onToggleClick);
          document.addEventListener('astro:page-load', bindThemeToggleUi);
        }
        bindThemeToggleUi();
      })();
    </script>
  </body>
</html>
