{
  "name": "kazkiueda-com",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "pages:dev": "bun run build && bunx wrangler pages dev ./dist",
    "deploy:pages": "bun run build && bunx wrangler pages deploy ./dist --project-name=kazkiueda-com",
    "deploy": "bun run deploy:pages",
    "check": "astro check",
    "knip": "knip",
    "jscpd": "jscpd",
    "verify:color-semantics": "bash scripts/check-color-semantics.sh",
    "verify": "bun run check && bun run verify:color-semantics && bun run knip && bun run jscpd",
    "astro": "astro",
    "generate-types": "wrangler types"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.2.10",
    "@radix-ui/colors": "3.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.5",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-slug": "^6.0.0",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@types/node": "^25.6.0",
    "jscpd": "^4.0.9",
    "knip": "^6.4.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.81.1"
  },
  "overrides": {
    "vite": "^7"
  }
}
